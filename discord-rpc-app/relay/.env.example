# Century relay environment. Copy to .env and fill in. Never commit .env.
# Secrets live ONLY in relay/.env, never in client code or chat.

# Music library root for the YTM downloader and metadata editor.
# Resolution order: CENTURY_MUSIC_DIR, ND_MUSICFOLDER, CENTURY_STORAGE_DIR,
# then <relay>/music. Downloads and tag writes stay inside this dir.
# CENTURY_MUSIC_DIR=/path/to/Music

# Bridge base URL for bridge-backed metadata editing (source=bridge) and
# for the YTM downloader's NAS destinations. The relay fetches NAS file
# bytes via this bridge, tags a temp copy, and uploads the result back.
# Default (when unset) is the hosted forwarder on :3006, which only exists
# when Photon is hosted on the VPS. For LOCAL use with the remote NAS
# bridge, set the bridge's public URL:
# CENTURY_BRIDGE_URL=https://files-api.planrift.me
# For a local bridge daemon on this machine instead, set:
# CENTURY_BRIDGE_URL=http://127.0.0.1:3001
# The bridge API key is NOT stored here; the deck sends it per-request as
# the x-bridge-key header (Settings localStorage century.nas_api_key).

# yt-dlp binary override. Resolution order: YT_DLP_PATH, relay/bin/yt-dlp,
# yt-dlp on PATH, python3 -m yt_dlp.
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# ffmpeg binary override. Resolution order: FFMPEG_PATH, ffmpeg on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# YouTube cookies for the YTM downloader (opt-in). YouTube blocks
# datacenter IPs with "Sign in to confirm you're not a bot" (HTTP 429);
# a cookies.txt exported from a browser while signed into a regular
# FREE YouTube account proves a logged-in human and bypasses that
# check. No YouTube Premium is needed, and no PO token is used.
# Resolution order: YT_DLP_COOKIES (CENTURY_YT_COOKIES alias), then
# <relay>/cookies.txt if it exists. When no file resolves, downloads
# behave exactly as before (no --cookies flag). The file must be
# Netscape-format cookies.txt (export with a "Get cookies.txt" browser
# extension while signed into YouTube). Never commit the file; it holds
# a live session. The relay only inspects counts and expiry, never
# logs or returns cookie values.
# YT_DLP_COOKIES=/path/to/cookies.txt

# Spotify client credentials for the metadata search (Spotify JP source).
# When absent, the Spotify source silently returns no results.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Gemini API key for lyrics translation/romaji fallback (existing feature).
# GEMINI_API_KEY=
