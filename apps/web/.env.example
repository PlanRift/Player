# Navidrome / Subsonic Server Credentials
# Replace with your NAS IP or domain (e.g., https://music.yourdomain.com or http://192.168.1.100:4533)
VITE_NAVIDROME_URL=https://music.yourdomain.com
VITE_NAVIDROME_USER=your-username
VITE_NAVIDROME_PASSWORD=your-password

# Optional: Last.fm API credentials (can also be entered directly in Settings UI)
VITE_LASTFM_API_KEY=
VITE_LASTFM_API_SECRET=
