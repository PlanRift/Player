# Relay Server Configuration
PORT=3005

# Google AI Studio Gemini API Key for English lyric translations
# Get a free key at https://aistudio.google.com/
# Server-side only: never committed to git or exposed to the client bundle
GEMINI_API_KEY=

# Optional: Gemini model override (defaults to gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest
