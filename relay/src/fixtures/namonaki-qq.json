    {
      "t": 68.93,
      "text": "僕が見つけた今日の煌めく空"
    },
    {
      "t": 74.96,
      "text": "誰かにちょっと 伝えたい"
    },
    {
      "t": 78.95,
      "text": "綺麗すぎる色は疲れるから"
    },
    {
      "t": 85.05,
      "text": "そのままを映していたい"
    },
    {
      "t": 90.12,
      "text": "何者でもない僕で"
