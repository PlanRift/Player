    {
      "t": 157.4,
      "text": "０じゃない1つを主張するため"
    },
    {
      "t": 163.41,
      "text": "僕はここに立っていたい"
    },
    {
      "t": 168.51,
      "text": "何者でもないままで"
    },
    {
      "t": 173.7,
      "text": "必ず叶う未来とか"
