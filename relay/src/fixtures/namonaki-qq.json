{
  "lines": [
    {
      "t": 0,
      "text": "名無声 - MyGO!!!!!"
    },
    {
      "t": 0.1,
      "text": "词：藤原優樹(SUPA LOVE)"
    },
    {
      "t": 0.31,
      "text": "曲：金崎真士(SUPA LOVE)"
    },
    {
      "t": 0.56,
      "text": "编曲：金崎真士(SUPA LOVE)"
    },
    {
      "t": 0.84,
      "text": "何が僕にできるか"
    },
    {
      "t": 5.72,
      "text": "わからないけれど"
    },
    {
      "t": 12.45,
      "text": "Oh oh oh oh oh oh oh oh"
    },
    {
      "t": 17.59,
      "text": "Oh oh oh oh oh oh oh oh"
    },
    {
      "t": 26.24,
      "text": "違うよ"
    },
    {
      "t": 27.74,
      "text": "どこかに向かう途中じゃない"
    },
    {
      "t": 32.12,
      "text": "今日の僕は 前日譚じゃない"
    },
    {
      "t": 36.68,
      "text": "足りない何かを求めてくより"
    },
    {
      "t": 42.21,
      "text": "僕のままで生きてみたい"
    },
    {
      "t": 47.22,
      "text": "遠くにある理想よりも"
    },
    {
      "t": 52.3,
      "text": "たった今に敏感に"
    },
    {
      "t": 56.06,
      "text": "ほんの数秒でアーカイブされて"
    },
    {
      "t": 61.01,
      "text": "過去になってく その前に"
    },
    {
      "t": 68.93,
      "text": "僕が見つけた今日の煌めく空"
    },
    {
      "t": 74.96,
      "text": "誰かにちょっと 伝えたい"
    },
    {
      "t": 78.95,
      "text": "綺麗すぎる色は疲れるから"
    },
    {
      "t": 85.05,
      "text": "そのままを映していたい"
    },
    {
      "t": 90.12,
      "text": "何者でもない僕で"
    },
    {
      "t": 95.86,
      "text": "Oh oh oh oh oh oh oh oh"
    },
    {
      "t": 100.7,
      "text": "Oh oh oh oh oh oh oh oh"
    },
    {
      "t": 104.83,
      "text": "ちょうどよく笑って"
    },
    {
      "t": 107.47,
      "text": "「それわかる」とか"
    },
    {
      "t": 110.2,
      "text": "何故うまく言えないんだろう"
    },
    {
      "t": 114.92,
      "text": "本当の気持ちを加工しなくちゃ"
    },
    {
      "t": 120.47,
      "text": "「みんな」には なれないみたい"
    },
    {
      "t": 125.47,
      "text": "たったひとつのアカウントじゃ"
    },
    {
      "t": 130.59,
      "text": "表せないように"
    },
    {
      "t": 134.43,
      "text": "幾つもの僕をもっているけど"
    },
    {
      "t": 139.34,
      "text": "どこにもいない そんな気持ち"
    },
    {
      "t": 147.3,
      "text": "僕が口ずさんだ歌は誰も"
    },
    {
      "t": 153.27,
      "text": "知らないけど ここにある"
    },
    {
      "t": 157.4,
      "text": "０じゃない1つを主張するため"
    },
    {
      "t": 163.41,
      "text": "僕はここに立っていたい"
    },
    {
      "t": 168.51,
      "text": "何者でもないままで"
    },
    {
      "t": 173.7,
      "text": "必ず叶う未来とか"
    },
    {
      "t": 178.57,
      "text": "確かなこたえがないなら"
    },
    {
      "t": 183.29,
      "text": "おどおどでも グラグラでも"
    },
    {
      "t": 188.31,
      "text": "歩いていける強さがほしい"
    },
    {
      "t": 205.45,
      "text": "何が僕にできるか"
    },
    {
      "t": 210.36,
      "text": "わからないけれど"
    },
    {
      "t": 215.56,
      "text": "心がぎゅって動いた"
    },
    {
      "t": 220.45,
      "text": "それを声にしたい"
    },
    {
      "t": 225.69,
      "text": "僕が見つけた今日の煌めく空"
    },
    {
      "t": 231.6,
      "text": "彷徨う雲 泳いでく"
    },
    {
      "t": 235.64,
      "text": "綺麗すぎる色で飾らないで"
    },
    {
      "t": 241.65,
      "text": "そのままを抱きしめていたい"
    },
    {
      "t": 246.74,
      "text": "何者でもない僕で"
    },
    {
      "t": 252.47,
      "text": "Oh oh oh oh oh oh oh oh"
    },
    {
      "t": 257.5,
      "text": "Oh oh oh oh oh oh oh oh"
    }
  ],
